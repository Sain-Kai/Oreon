# Copy this to .env and fill in real values. Never commit the real .env file.

NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_CHAT_MODEL=meta/llama-3.1-70b-instruct

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_FALLBACK_CHAT_MODEL=z-ai/glm-5.2:free

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# Must match the embedding model's actual output dimension - check its docs before first run
EMBEDDING_DIMENSIONS=2048

RATE_LIMIT_RPM=20
